# Public website origin used in the built HTML's Open Graph image/canonical URLs.
# On Vercel, an empty value uses VERCEL_PROJECT_PRODUCTION_URL automatically.
SITE_URL=
# Public JavaScript app key; register the same website in Kakao Developers.
# Do not use an Admin key, REST API key, or client secret here.
VITE_KAKAO_JAVASCRIPT_KEY=
# Supabase public configuration. Never put a service_role or secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
